---
import Base from '../layouts/Base.astro';
import Forms from '../components/Forms.astro';
import Close from '../components/Close.astro';
import { site } from '../site';
---
<Base title="Fees" description="Counselling fees for couples and individual sessions with Rachel Glover, RCC, plus a free 15-minute consultation.">
  <div class="wrap"><section class="pg-hero">
    <div class="copy">
      <p class="eyebrow rise" style="--d:.1s">Fees</p>
      <h1 class="b-h1"><span class="mask"><span style="--d:.2s">Clear fees,</span></span><span class="mask acc"><span style="--d:.36s">set out up front.</span></span></h1>
      <p class="lede rise" style="--d:.65s">Every new client starts with a free 15-minute consultation, a chance to tell me a little about what’s going on and ask questions.</p>
      <div class="rise" style="--d:.8s;display:flex;gap:14px 20px;flex-wrap:wrap;align-items:center"><a class="btn" href={site.bookingUrl}>Book a free 15-minute consultation <span class="arr">→</span></a></div>
    </div>
    <Forms kind="two" />
  </section></div>

  <section class="band alt"><div class="wrap a1-fees">
    <div class="reveal stack"><p class="eyebrow">Session fees</p><h2 class="b-h1 h2">Couples and individual counselling</h2><p class="body">Sessions are available in-person in Victoria or virtually across BC.</p></div>
    <div class="reveal stack" style="gap:36px">
      <div><p class="list-label">Couples counselling</p>
        <ul class="fee-list">
          <li><span class="what">60-minute session</span><span class="len"></span><span class="amt">$180</span></li>
          <li><span class="what">75-minute session</span><span class="len"></span><span class="amt">$225</span></li>
          <li><span class="what">90-minute session</span><span class="len"></span><span class="amt">$270</span></li>
        </ul></div>
      <div><p class="list-label">Individual counselling</p>
        <ul class="fee-list"><li><span class="what">60-minute session</span><span class="len"></span><span class="amt">$140</span></li></ul></div>
    </div>
  </div></section>

  <Close />
</Base>
