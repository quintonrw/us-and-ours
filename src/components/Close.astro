---
// Closing call to action used at the foot of each page.
import { site } from '../site';
---
<section class="band dark close-band"><div class="wrap b1-close reveal">
  <h2 class="b-h1">Let’s talk. <span>The first conversation matters.</span></h2>
  <p class="lede">A free 15-minute consultation to tell me a little about what’s going on and see whether working together feels right.</p>
  <div style="display:flex;gap:14px;flex-wrap:wrap;align-items:center">
    <a class="btn light-fill" href={site.bookingUrl}>Book a free 15-minute consultation <span class="arr">→</span></a>
    <a class="btn ghost" href="/contact#qform">Send a message</a>
  </div>
  <p class="where-line">In-person in Victoria · Virtual across BC</p>
</div></section>
