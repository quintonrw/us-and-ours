---
import Base from '../layouts/Base.astro';
import Forms from '../components/Forms.astro';
import Close from '../components/Close.astro';
import { site } from '../site';
---
<Base title="Home" description="Couples, stepfamily and individual counselling with Rachel Glover, RCC. In-person in Victoria, BC and virtual across BC. Book a free 15-minute consultation.">
  <div class="wrap">
    <section class="b1-hero">
      <div class="copy">
        <p class="eyebrow rise" style="--d:.1s">In-person in Victoria · Virtual across BC</p>
        <h1 class="b-h1"><span class="mask"><span style="--d:.25s">Two people.</span></span><span class="mask acc"><span style="--d:.45s">One way forward.</span></span></h1>
        <p class="lede rise" style="--d:.8s">Relationships take work, but most of us were never taught how. I’m Rachel Glover, RCC, and I help you understand what’s happening, see it from a different perspective and learn better ways through it.</p>
        <div class="rise" style="--d:.95s;display:flex;gap:14px;flex-wrap:wrap"><a class="btn" href={site.bookingUrl}>Book a free 15-minute consultation <span class="arr">→</span></a><a class="btn ghost" href="#how-it-starts">How it works</a></div>
      </div>
      <Forms kind="two" class="b1-forms" />
    </section>
  </div>

  <section class="band alt">
    <div class="wrap">
      <div class="reveal" style="display:flex;flex-direction:column;gap:18px;max-width:760px"><p class="eyebrow">How I can help</p><h2 class="b-h1" style="font-size:clamp(36px,4.4vw,60px)">Practical support for the relationships that matter to you.</h2></div>
      <div class="b1-cards weighted stagger">
        <a class="b1-card feature" href="/couples">
          <svg class="ic" viewBox="0 0 116 80" aria-hidden="true"><use href="#markB-dark" /></svg>
          <span class="tag">Couples counselling</span>
          <h3>Communicate better. Feel closer. Grow together.</h3>
          <p>Every couple wants to feel close, and every couple has differences that create conflict. It doesn’t have to be one or the other. We’ll look at the patterns you’ve fallen into and learn practical ways to work through problems as a team.</p>
          <span class="more">Learn more <span>→</span></span>
        </a>
        <a class="b1-card" href="/stepfamilies"><svg class="ic" viewBox="0 0 116 80" aria-hidden="true"><circle cx="30" cy="40" r="24" fill="#CDB792" /><circle cx="58" cy="40" r="24" fill="none" stroke="#5C1A26" stroke-width="2" /><circle cx="86" cy="40" r="24" fill="none" stroke="#655247" stroke-width="1.4" /></svg><h3>Stepparent &amp; stepfamily support</h3><p>Stepfamily life is complex. I’ll help you understand why it feels so hard, with a road map research shows works.</p><span class="more">Learn more <span>→</span></span></a>
        <a class="b1-card" href="/individuals"><svg class="ic" viewBox="0 0 116 80" aria-hidden="true"><circle cx="58" cy="40" r="34" fill="none" stroke="#5C1A26" stroke-width="2" /><circle cx="58" cy="40" r="20" fill="#CDB792" /></svg><h3>Individual counselling</h3><p>Change starts with you. Understand what’s keeping you stuck, and what is and isn’t within your control.</p><span class="more">Learn more <span>→</span></span></a>
      </div>
    </div>
  </section>

  <section class="b1-about">
    <div class="photo slide-up"><img src="/img/rachel-chair.jpg" alt="Rachel Glover, RCC, seated in an armchair in her office" style="object-position:50% 8%" loading="lazy" decoding="async" /></div>
    <div class="txt reveal">
      <p class="eyebrow">Meet Rachel</p>
      <h2 class="b-h1">Warm, direct and actively engaged.</h2>
      <p class="body">I’m a Registered Clinical Counsellor in Victoria with a passion for couples, relationships and stepfamily dynamics. As a wife, mother and stepmother, I know relationships take ongoing work, patience and a willingness to keep learning.</p>
      <div><a class="btn ghost light" href="/about">More about Rachel <span class="arr">→</span></a></div>
    </div>
  </section>

  <section class="band" id="how-it-starts">
    <div class="wrap">
      <div class="reveal"><p class="eyebrow">How it starts</p></div>
      <div class="b1-steps stagger">
        <div class="b1-step"><span class="n">STEP 1</span><h3>Free 15-minute consultation</h3><p class="body">Tell me a little about what’s going on and see whether working together feels right.</p></div>
        <div class="b1-step"><span class="n">STEP 2</span><h3>First session</h3><p class="body">We get clear about what you want to change and keep our sessions focused on it.</p></div>
        <div class="b1-step"><span class="n">STEP 3</span><h3>Ongoing sessions</h3><p class="body">In-person at Kings Rd or virtually across BC, with skills to try between sessions.</p></div>
      </div>
    </div>
  </section>

  <Close />
</Base>
